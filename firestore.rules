rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Patient Profile: strictly scoped to authenticated owner
    match /users/{userId}/profile/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Symptom triage evaluation history
    match /users/{userId}/symptom_history/{evalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // AI Conversations & Messages subcollection
    match /users/{userId}/conversations/{convId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Medication & Check-in Reminders
    match /users/{userId}/reminders/{reminderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny any unspecified collections
    match /{document=**} {
      allow read, write: false;
    }
  }
}
